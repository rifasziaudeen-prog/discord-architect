# Configuration template for Discord Server Architect Bot
# Copy this file to .env and insert your credentials.

# ── Discord Bot Credentials ──────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here

# ── Google Gemini API Credentials ─────────────────────────────────────
# Provide one or more Gemini API keys (comma-separated for multi-key fallback)
GEMINI_API_KEYS=your_gemini_api_key_here

# ── Optional Bot Owner ID ─────────────────────────────────────────────
# Discord User ID of the global bot owner (bypasses all permission checks)
# If left blank, the bot owner is automatically detected from Discord API
BOT_OWNER_ID=

# ── Bot Defaults ──────────────────────────────────────────────────────
COMMAND_PREFIX=!
DEFAULT_AI_MODEL=gemini-3.1-flash-lite
LOG_LEVEL=INFO
